{
  "info": {
    "name": "Campus Lost and Found Portal API Tests",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "itemId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "2. Register user",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"name\":\"Postman Student\",\"email\":\"postman.student@example.com\",\"password\":\"Student123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/register"
      }
    },
    {
      "name": "3. Login user",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) { pm.collectionVariables.set('token', pm.response.json().token); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"email\":\"postman.student@example.com\",\"password\":\"Student123!\"}"
        },
        "url": "{{baseUrl}}/api/auth/login"
      }
    },
    {
      "name": "4. Invalid item report - expect 400",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"\"}"
        },
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "5. Get all items",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/items"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const items = pm.response.json().items || [];",
              "if (items.length) { pm.collectionVariables.set('itemId', items[0]._id); }"
            ]
          }
        }
      ]
    },
    {
      "name": "6. Create item",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('itemId', pm.response.json().item._id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"Postman Test Notebook\",\"category\":\"Books\",\"description\":\"Blue notebook used for API testing\",\"location\":\"Library\",\"itemDate\":\"2026-11-14\",\"type\":\"found\"}"
        },
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "7. Update item",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"description\":\"Updated description from Postman\"}"
        },
        "url": "{{baseUrl}}/api/items/{{itemId}}"
      }
    },
    {
      "name": "8. Unauthorized create item - expect 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"title\":\"No token item\"}"
        },
        "url": "{{baseUrl}}/api/items"
      }
    },
    {
      "name": "9. Submit claim",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"itemId\":\"{{itemId}}\",\"message\":\"I can identify this item. It has a unique mark known to me.\"}"
        },
        "url": "{{baseUrl}}/api/claims"
      }
    },
    {
      "name": "10. Get my claims",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/claims/mine"
      }
    },
    {
      "name": "11. Admin stats - normal student expects 403",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          }
        ],
        "url": "{{baseUrl}}/api/admin/stats"
      }
    }
  ]
}
